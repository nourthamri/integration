<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.forum.CreerCommentaire"
      stylesheets="@../css/modern-styles.css"
      spacing="10"
      styleClass="root">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    


    <!-- En-tête - Conservé tel quel avec adaptation CSS -->
    <HBox alignment="CENTER" styleClass="container">
        <Label text="Nouveau Commentaire" styleClass="title"/>
    </HBox>

    <!-- Formulaire de création de commentaire - Structure conservée -->
    <GridPane hgap="10" vgap="10" styleClass="form-container">
        <Label text="Contenu:" styleClass="subtitle" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="contentField" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="ID du Post:" styleClass="subtitle" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="postIdField" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

    </GridPane>

    <!-- Boutons d'action - Conservés identiques avec adaptation CSS -->
    <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="button-container">
        <Button text="Annuler" onAction="#closeWindow" styleClass="button button-secondary"/>
        <Button text="Ajouter" onAction="#handleAdd" defaultButton="true" styleClass="button button-success"/>
    </HBox>
</VBox>