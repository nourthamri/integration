<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.forum.MenuPrincipalController"
      spacing="20"
      alignment="CENTER"
      styleClass="root container"
      stylesheets="@style.css">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <HBox alignment="CENTER" styleClass="header-box">
        <Label text="Bienvenue dans le Forum" styleClass="title"/>
    </HBox>

    <VBox spacing="15" alignment="CENTER">
        <Button text="Gestion des Posts"
                onAction="#handleAfficherPosts"
                styleClass="button button-primary"
                minWidth="200"/>

        <Button text="Gestion des Commentaires"
                onAction="#handleAfficherCommentaires"
                styleClass="button button-secondary"
                minWidth="200"/>
    </VBox>
</VBox>