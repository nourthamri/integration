<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.AccueilFront"
            stylesheets="@/css/modern-styles.css"
            prefHeight="400.0" prefWidth="600.0">

    <children>
        <VBox spacing="20" alignment="CENTER"
              AnchorPane.topAnchor="50.0"
              AnchorPane.leftAnchor="50.0"
              AnchorPane.rightAnchor="50.0"
              AnchorPane.bottomAnchor="50.0">
            <Button fx:id="btnCreer" text="➕ Créer une réclamation" onAction="#allerVersCreation"/>
            <Button fx:id="btnVoir" text="👁️ Voir mes réclamations" onAction="#allerVersListe"/>
            <Button text="📊 Tableau de Bord" onAction="#loadDashboard" styleClass="btn-dashboard"/>
        </VBox>
    </children>
</AnchorPane>
