<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.Detailsreclamation"
            prefHeight="400.0" prefWidth="600.0"
            stylesheets="@../css/modern-styles.css">
    <children>
        <VBox spacing="16" alignment="CENTER" AnchorPane.topAnchor="20.0" AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0" AnchorPane.bottomAnchor="20.0">

            <Label text="Détails de la réclamation" styleClass="title"/>

            <TextArea fx:id="txtReponse" editable="false" promptText="Aucune réponse" wrapText="true" prefRowCount="4"/>
            <TextArea fx:id="txtRemboursement" editable="false" promptText="Aucun remboursement" wrapText="true" prefRowCount="2"/>

            <Button text="Fermer" onAction="#fermer"/>
        </VBox>
    </children>
</AnchorPane>
