<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.Detailsreclamation"
            prefHeight="400.0" prefWidth="600.0"
            stylesheets="@/css/modern-styles.css">

    <children>
        <VBox spacing="16" alignment="CENTER"
              AnchorPane.topAnchor="20.0" AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0" AnchorPane.bottomAnchor="20.0"
              styleClass="container">

            <Label text="📝 Détails de la réclamation" styleClass="title"/>



            <TextArea fx:id="txtReponse"
                      editable="false"
                      wrapText="true"
                      prefRowCount="4"
                      promptText="Aucune réponse encore..."
                      styleClass="text-area"/>

            <TextArea fx:id="txtRemboursement"
                      editable="false"
                      wrapText="true"
                      prefRowCount="2"
                      promptText="Aucun remboursement disponible."
                      styleClass="text-area"/>

            <Label text="Progress Bar" styleClass="title"/>

            <ProgressBar fx:id="progressBar"
                         prefWidth="400"
                         progress="0.0"
                         styleClass="progress-indicator"/>

            <Button text="Fermer"
                    onAction="#fermer"
                    styleClass="button-secondary"/>
        </VBox>
    </children>
</AnchorPane>