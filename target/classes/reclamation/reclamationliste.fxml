<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.reclamation.listereclamation"
            stylesheets="@../css/modern-styles.css"
            prefWidth="900.0" prefHeight="600.0">

   <!-- Sidebar -->
   <left>
      <fx:include source="/sidebar.fxml"/>
   </left>

   <!-- Contenu principal -->
   <center>
      <VBox spacing="16" styleClass="container" alignment="TOP_CENTER" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
         </padding>

         <!-- Titre -->
         <AnchorPane>
            <children>
               <Label styleClass="title" text="Liste des Réclamations"
                      AnchorPane.leftAnchor="0.0"/>
               <Button fx:id="btnRefresh" styleClass="refresh-button" text="🔄 Rafraîchir"
                       AnchorPane.rightAnchor="0.0"/>
            </children>
         </AnchorPane>

         <!-- Zone de filtrage et recherche -->
         <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Rechercher..." />
            <ComboBox fx:id="statusFilter" promptText="Statut" />
            <ComboBox fx:id="categoryFilter" promptText="Catégorie" />
            <DatePicker fx:id="dateFilter" promptText="Date" />
            <Button fx:id="btnApplyFilters" text="Appliquer filtres"/>
            <!-- Dans reclamationliste.fxml -->
            <Button text="Exporter" onAction="#handleExport" />
         </HBox>

         <!-- Liste des réclamations -->
         <ListView fx:id="listViewReclamations" VBox.vgrow="ALWAYS"/>
      </VBox>
   </center>
</BorderPane>
