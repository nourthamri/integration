<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane prefWidth="800.0" prefHeight="600.0" 
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.categorie.GestionCategorieController"
            stylesheets="@../css/modern-styles.css">
    <children>
        <VBox styleClass="container" spacing="24"
              AnchorPane.topAnchor="24.0" 
              AnchorPane.leftAnchor="24.0" 
              AnchorPane.rightAnchor="24.0" 
              AnchorPane.bottomAnchor="24.0">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            
            <children>
                <!-- Titre -->
                <Label text="Gestion des catégories" styleClass="title"/>
                
                <!-- Liste et Formulaire Container -->
                <HBox spacing="24" VBox.vgrow="ALWAYS">
                    <!-- Liste des catégories -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Liste des catégories" styleClass="subtitle"/>
                        <ListView fx:id="listCategorie" VBox.vgrow="ALWAYS"/>
                    </VBox>
                    
                    <!-- Formulaire -->
                    <VBox spacing="16" prefWidth="300">
                        <Label text="Détails de la catégorie" styleClass="subtitle"/>
                        
                        <!-- Champ Nom -->
                        <VBox spacing="8">
                            <Label text="Nom" styleClass="subtitle"/>
                            <TextField fx:id="nomField" promptText="Nom de la catégorie"/>
                        </VBox>
                        
                        <!-- Boutons -->
                        <VBox spacing="8">
                            <Button fx:id="btnAjouter" text="Ajouter" 
                                    styleClass="button-success" maxWidth="Infinity"/>
                            <Button fx:id="btnModifier" text="Modifier" 
                                    styleClass="button-warning" maxWidth="Infinity"/>
                            <Button fx:id="btnSupprimer" text="Supprimer" 
                                    styleClass="button-error" maxWidth="Infinity"/>
                            <Button fx:id="btnRafraichir" text="⟳ " />
                        </VBox>
                        
                        <!-- Spacer -->
                        <Region VBox.vgrow="ALWAYS"/>
                    </VBox>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
