<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.ResetPasswordController">
    <children>
        <StackPane alignment="CENTER">
            <VBox alignment="CENTER" spacing="20.0"
                  style="-fx-background-color: rgba(0, 0, 0, 0.9); -fx-background-radius: 20; -fx-padding: 30;">

                <Label text="Réinitialiser le mot de passe" style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;" />

                <Label text="Nouveau mot de passe:" style="-fx-text-fill: white; -fx-font-size: 16px;" />
                <PasswordField fx:id="newPasswordField" promptText="Nouveau mot de passe"
                               style="-fx-background-radius: 10; -fx-padding: 8; -fx-font-size: 14px; -fx-pref-width: 250px; -fx-background-color: white;" />

                <Label text="Confirmer le mot de passe:" style="-fx-text-fill: white; -fx-font-size: 16px;" />
                <PasswordField fx:id="confirmPasswordField" promptText="Confirmer mot de passe"
                               style="-fx-background-radius: 10; -fx-padding: 8; -fx-font-size: 14px; -fx-pref-width: 250px; -fx-background-color: white;" />

                <Button text="Changer le mot de passe" onAction="#changePassword"
                        style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 10; -fx-padding: 10 20;" />

                <Label fx:id="statusLabel" text="" style="-fx-text-fill: red; -fx-font-size: 14px; -fx-font-weight: bold;" />
            </VBox>
        </StackPane>
    </children>
</AnchorPane>

