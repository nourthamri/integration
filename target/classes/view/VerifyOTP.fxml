<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="500.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.VerifyOTPController">
    <children>
        <StackPane alignment="CENTER">
            <VBox alignment="CENTER" spacing="20.0"
                  style="-fx-background-color: rgba(0, 0, 0, 0.9); -fx-background-radius: 20; -fx-padding: 30;">

                <Label text="Vérification OTP" style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;" />

                <Label text="Entrez l'OTP reçu par email:" style="-fx-text-fill: white; -fx-font-size: 16px;" />

                <TextField fx:id="otpField" promptText="Votre OTP"
                           style="-fx-background-radius: 10; -fx-padding: 8; -fx-font-size: 14px; -fx-pref-width: 200px; -fx-pref-height: 30px; -fx-background-color: white; -fx-alignment: center;" />

                <Button text="Vérifier" onAction="#verifyOtp"
                        style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 10; -fx-padding: 10 20;" />

                <Label fx:id="statusLabel" text="" style="-fx-text-fill: red; -fx-font-size: 14px; -fx-font-weight: bold;" />
            </VBox>
        </StackPane>
    </children>
</AnchorPane>

