<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.LoginHistoryController"
            prefHeight="400.0" prefWidth="600.0">

    <TableView fx:id="loginHistoryTable" layoutX="14.0" layoutY="14.0" prefHeight="372.0" prefWidth="570.0">
        <columns>
            <TableColumn fx:id="ipColumn" text="IP Address" prefWidth="150"/>
            <TableColumn fx:id="deviceColumn" text="Device Info" prefWidth="150"/>
            <TableColumn fx:id="loginTimeColumn" text="Login Time" prefWidth="200"/>
        </columns>
    </TableView>
</AnchorPane>
