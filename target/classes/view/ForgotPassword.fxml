<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<AnchorPane prefHeight="1080.0" prefWidth="1920.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.ForgotPasswordController">
    <children>
        <!-- Background Image -->


        <!-- Centered StackPane for Forgot Password Card -->
        <StackPane prefHeight="400.0" prefWidth="500.0" alignment="CENTER"
                   AnchorPane.topAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0">
            <VBox alignment="CENTER" spacing="20.0"
                  style="-fx-background-color: rgba(0, 0, 0, 0.8); -fx-background-radius: 20; -fx-padding: 30; -fx-alignment: center;">

                <!-- Football Icon -->


                <Label text="Mot de passe oublié"
                       style="-fx-font-size: 28px; -fx-text-fill: white; -fx-font-weight: bold;" />

                <Label text="Entrez votre Email:"
                       style="-fx-text-fill: white; -fx-font-size: 16px;" />

                <!-- Centered SMALL Input Field Inside HBox -->
                <HBox alignment="CENTER">
                    <TextField fx:id="emailField" promptText="Votre Email"
                               style="-fx-background-radius: 10;
                                      -fx-padding: 8;
                                      -fx-font-size: 14px;
                                      -fx-pref-width: 200px;
                                      -fx-pref-height: 30px;
                                      -fx-background-color: white;
                                      -fx-alignment: center;" />
                </HBox>

                <Button text="Envoyer OTP" onAction="#sendOtp"
                        style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 10; -fx-padding: 10 20;" />

                <Label fx:id="statusLabel" text=""
                       style="-fx-text-fill: red; -fx-font-size: 14px; -fx-font-weight: bold;" />
            </VBox>
        </StackPane>
    </children>
</AnchorPane>





