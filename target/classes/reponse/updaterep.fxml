<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.reponse.Updaterep"
            stylesheets="@../css/modern-styles.css"
            prefWidth="800.0" prefHeight="600.0">

    <!-- Sidebar à gauche -->
    <left>
        <fx:include source="/sidebar.fxml"/>
    </left>

    <!-- Contenu principal -->
    <center>
        <VBox styleClass="container" spacing="24" alignment="TOP_CENTER"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
            </padding>

            <!-- Titre -->
            <Label text="Modifier la réponse" styleClass="title"/>

            <!-- Formulaire -->
            <VBox spacing="16">
                <VBox spacing="8">
                    <Label text="Contenu" styleClass="subtitle"/>
                    <TextField fx:id="contenu" promptText="Modifiez votre réponse"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Date" styleClass="subtitle"/>
                    <DatePicker fx:id="date" promptText="Sélectionnez une date"/>
                </VBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Bouton -->
            <Button fx:id="update" text="Mettre à jour la réponse"
                    styleClass="button-warning"
                    maxWidth="Infinity"/>
        </VBox>
    </center>
</BorderPane>
