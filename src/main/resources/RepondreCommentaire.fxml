<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.RepondreCommentaireController"
      spacing="10"
      style="-fx-padding: 15; -fx-background-color: #f5f5f5;"
      prefWidth="400">

    <Label text="Répondre au commentaire:" style="-fx-font-weight: bold;"/>
    <TextArea fx:id="reponseText"
              promptText="Écrivez votre réponse ici..."
              wrapText="true"
              prefRowCount="4"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler"
                styleClass="button button-secondary"
                onAction="#handleAnnuler"/>
        <Button text="Envoyer"
                styleClass="button button-primary"
                onAction="#handleReponse"/>
    </HBox>
</VBox>