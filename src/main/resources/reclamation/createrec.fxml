<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane prefWidth="600.0" prefHeight="500.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.reclamation.Createrec"
            stylesheets="@../css/modern-styles.css">
    <children>
        <VBox styleClass="container" spacing="24"
              AnchorPane.topAnchor="24.0"
              AnchorPane.leftAnchor="24.0"
              AnchorPane.rightAnchor="24.0"
              AnchorPane.bottomAnchor="24.0">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <children>
                <!-- Titre -->
                <Label text="Nouvelle Réclamation" styleClass="title"/>

                <!-- Form Container -->
                <VBox spacing="16">
                    <!-- Champ Titre -->
                    <VBox spacing="8">
                        <Label text="Titre" styleClass="subtitle"/>
                        <TextField fx:id="titre" promptText="Entrez le titre"/>
                    </VBox>

                    <!-- Champ Description -->
                    <VBox spacing="8">
                        <Label text="Description" styleClass="subtitle"/>
                        <TextArea fx:id="desc" promptText="Entrez la description"
                                  prefRowCount="3" wrapText="true"/>
                    </VBox>

                    <!-- Date Picker -->
                    <VBox spacing="8">
                        <Label text="Date" styleClass="subtitle"/>
                        <DatePicker fx:id="date" promptText="Sélectionnez une date"/>
                    </VBox>

                    <!-- Catégorie -->
                    <VBox spacing="8">
                        <Label text="Catégorie" styleClass="subtitle"/>
                        <ComboBox fx:id="categorieCombo" promptText="Choisir une catégorie"
                                  maxWidth="Infinity"/>
                    </VBox>
                </VBox>

                <!-- Spacer -->
                <Region VBox.vgrow="ALWAYS"/>

                <!-- Bouton -->
                <Button fx:id="add" text="Ajouter la réclamation"
                        onMouseEntered="#buttonHover" onMouseExited="#buttonExit"
                        maxWidth="Infinity"/>
            </children>
        </VBox>
    </children>
</AnchorPane>
