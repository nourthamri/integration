<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.reclamation.Createrec"
            stylesheets="@../css/modern-styles.css"
            prefWidth="900.0" prefHeight="600.0">

    <!-- Sidebar à gauche -->
    <left>
        <fx:include source="/sidebar.fxml"/>
    </left>

    <!-- Contenu principal -->
    <center>
        <VBox styleClass="container" spacing="24" alignment="TOP_CENTER"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets top="32.0" right="32.0" bottom="32.0" left="32.0"/>
            </padding>

            <Label text="Nouvelle Réclamation" styleClass="title"/>

            <VBox spacing="16">
                <!-- Champ Titre -->
                <VBox spacing="8">
                    <Label text="Titre" styleClass="subtitle"/>
                    <TextField fx:id="titre" promptText="Entrez le titre"/>
                </VBox>

                <!-- Champ Description -->
                <VBox spacing="8">
                    <Label text="Description" styleClass="subtitle"/>
                    <TextArea fx:id="desc" promptText="Entrez la description"
                              prefRowCount="3" wrapText="true"/>
                </VBox>

                <!-- Champ Date -->
                <VBox spacing="8">
                    <Label text="Date" styleClass="subtitle"/>
                    <DatePicker fx:id="date" promptText="Sélectionnez une date"/>
                </VBox>

                <!-- ComboBox Catégorie -->
                <VBox spacing="8">
                    <Label text="Catégorie" styleClass="subtitle"/>
                    <ComboBox fx:id="categorieCombo" promptText="Choisir une catégorie"
                              maxWidth="Infinity"/>
                </VBox>

                <!-- Champ Email -->
                <VBox spacing="8">
                    <Label text="Email" styleClass="subtitle"/>
                    <TextField fx:id="emailField" promptText="Entrez votre email"/>
                </VBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Boutons en bas -->
            <VBox spacing="12">
                <Button fx:id="add"
                        text="Ajouter la réclamation"
                        onMouseEntered="#buttonHover"
                        onMouseExited="#buttonExit"
                        maxWidth="Infinity"/>

                <Button fx:id="chatbotButton"
                        text="Ouvrir le Chatbot"
                        onAction="#openChatbot"
                        style="-fx-background-color: #6fa3ef; -fx-text-fill: white; -fx-padding: 12px 24px;"
                        onMouseEntered="#buttonHoverChatbot"
                        onMouseExited="#buttonExitChatbot"
                        maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>