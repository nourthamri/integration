<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.reclamation.DashboardController"
            stylesheets="@/css/dashboard.css">

    <center>
        <VBox spacing="20">
            <!-- Camembert : Répartition par statut -->
            <PieChart fx:id="pieChartStatut" title="Réclamations par Statut"/>

            <BarChart fx:id="barChartCategories" title="Réclamations par Catégorie">
                <xAxis><CategoryAxis/></xAxis>
                <yAxis><NumberAxis/></yAxis>
            </BarChart>

            <LineChart fx:id="lineChartMois" title="Évolution Mensuelle des Réclamations">
                <xAxis>
                    <CategoryAxis label="Mois" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Nombre de réclamations" />
                </yAxis>
            </LineChart>

            <!-- Bouton corrigé -->
            <Button text="Exporter les Statistiques" onAction="#handleExportStats" />
        </VBox>
    </center>
</BorderPane>