<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane prefWidth="600.0" prefHeight="500.0" 
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.reponse.Updaterep"
            stylesheets="@../css/modern-styles.css">
    <children>
        <VBox styleClass="container" spacing="24"
              AnchorPane.topAnchor="24.0" 
              AnchorPane.leftAnchor="24.0" 
              AnchorPane.rightAnchor="24.0" 
              AnchorPane.bottomAnchor="24.0">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            
            <children>
                <!-- Titre -->
                <Label text="Modifier la réponse" styleClass="title"/>
                
                <!-- Form Container -->
                <VBox spacing="16">
                    <!-- Contenu -->
                    <VBox spacing="8">
                        <Label text="Contenu" styleClass="subtitle"/>
                        <TextField fx:id="contenu" promptText="Modifiez votre réponse"/>
                    </VBox>
                    
                    <!-- Date -->
                    <VBox spacing="8">
                        <Label text="Date" styleClass="subtitle"/>
                        <DatePicker fx:id="date" promptText="Sélectionnez une date"/>
                    </VBox>
                </VBox>
                
                <!-- Spacer -->
                <Region VBox.vgrow="ALWAYS"/>
                
                <!-- Bouton -->
                <Button fx:id="update" text="Mettre à jour la réponse"
                        styleClass="button-warning"
                        maxWidth="Infinity"/>
            </children>
        </VBox>
    </children>
</AnchorPane>
