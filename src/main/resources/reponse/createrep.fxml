<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.reponse.Createrep"
            stylesheets="@../css/modern-styles.css"
            prefWidth="900.0" prefHeight="600.0">

    <!-- Sidebar -->
    <left>
        <fx:include source="/sidebar.fxml"/>
    </left>

    <!-- Contenu principal -->
    <center>
        <VBox styleClass="container" spacing="24" alignment="TOP_CENTER"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets top="32.0" right="32.0" bottom="32.0" left="32.0"/>
            </padding>

            <Label text="Nouvelle réponse" styleClass="title"/>

            <VBox spacing="16">
                <VBox spacing="8">
                    <Label text="Contenu" styleClass="subtitle"/>
                    <TextField fx:id="cont" promptText="Entrez votre réponse"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Date" styleClass="subtitle"/>
                    <DatePicker fx:id="Date" promptText="Sélectionnez une date"/>
                </VBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="Add" text="Ajouter la réponse"
                    styleClass="button-success"
                    maxWidth="Infinity"/>
        </VBox>
    </center>
</BorderPane>
