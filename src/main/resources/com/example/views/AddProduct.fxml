<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="piproject.controllers.AddProductController"
            prefHeight="600.0" prefWidth="800.0"
            stylesheets="@style.css"
            styleClass="root">

    <VBox spacing="16" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="40" AnchorPane.rightAnchor="40"
          styleClass="container">
        <Label text="Ajouter un Produit" styleClass="title" />

        <TextField fx:id="nomField" promptText="Nom du produit" styleClass="text-field" />
        <TextField fx:id="descriptionField" promptText="Description" styleClass="text-field" />
        <TextField fx:id="couponField" promptText="Coupon" styleClass="text-field" />
        <TextField fx:id="valeurField" promptText="Valeur" styleClass="text-field" />
        <TextField fx:id="etatField" promptText="État" styleClass="text-field" />
        <TextField fx:id="dispoField" promptText="Disponibilité" styleClass="text-field" />
        <ComboBox fx:id="categorieCombo" promptText="Catégorie" styleClass="combo-box" />

        <Button text="📷 Choisir une image" onAction="#onChooseImage" styleClass="button-secondary" />
        <Label fx:id="statusLabel" textFill="green" />

        <HBox spacing="12">
            <Button text="✅ Ajouter" onAction="#onAddProduct" styleClass="button-success" />
            <Button text="↩️ Retour" onAction="#onBack" styleClass="button-secondary" />
        </HBox>
    </VBox>
</AnchorPane>
