<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="piproject.controllers.productController"
            stylesheets="@style.css"> <!-- 👈 Add this line -->

    <center>
        <VBox spacing="15" style="-fx-background-color: #f5f6fa;">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="10.0" /></padding>

            <!-- Title -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Text fill="#2c3e50" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Ajouter un Produit" />
            </HBox>

            <!-- Form Grid -->
            <GridPane hgap="10" vgap="8">
                <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>

                <Label text="Nom:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="nom" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="250" />

                <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="description" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="250" />

                <Label text="Coupon:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="coupon" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="250" />

                <Label text="Valeur:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="valeur" GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="250" />

                <Label text="État:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextField fx:id="etat" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="250" />

                <Label text="Disponibilité:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <TextField fx:id="dispo" GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="250" />

                <Label text="Catégorie:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                <ComboBox fx:id="categoriecombo" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                <Label text="Image:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="7">
                    <Button text="Choisir Image" onAction="#imageChoose"
                            style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
                    <ImageView fx:id="imagePreview" fitHeight="80.0" fitWidth="120.0" preserveRatio="true" />
                </HBox>

                <Label fx:id="statusLabel" GridPane.columnIndex="1" GridPane.rowIndex="8" textFill="green" />

                <columnConstraints>
                    <ColumnConstraints />
                    <ColumnConstraints />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

            <!-- Product List -->
            <ListView fx:id="produitListView"
                      prefHeight="200.0"
                      prefWidth="700.0"
                      onMouseClicked="#onProductSelected"
                      styleClass="custom-list-view">
                <VBox.margin><Insets top="10" /></VBox.margin>
            </ListView>

            <!-- Buttons -->
            <HBox alignment="CENTER_RIGHT" spacing="8">
                <Button text="Ajouter Produit" onMouseClicked="#add" styleClass="button"/>
                <Button fx:id="deleteBtn"
                        mnemonicParsing="false"
                        onAction="#deleteProduct"
                        text="🗑️ Supprimer Produit"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
                <Button onAction="#update"
                        prefWidth="90"
                        style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
                        text="Modifier" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
